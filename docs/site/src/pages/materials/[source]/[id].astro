---
import Base from "@/layouts/Base.astro";
import { loadCatalog, loadMeta, thumbUrl, tierDirUrl } from "@/data/load";
import type { TrimmedMaterial } from "@/data/load";

export async function getStaticPaths() {
  const catalog = loadCatalog();
  return catalog.map((mat) => ({
    params: { source: mat.s, id: mat.id },
    props: { mat },
  }));
}

interface Props {
  mat: TrimmedMaterial;
}
const { mat } = Astro.props;
const meta = loadMeta();
const base = import.meta.env.BASE_URL;

// Compose a direct-download URL for each available tier. The substrate
// layout publishes per-file artifacts under `<tier>/<source>/<id>/`
// (see ADR-0012); for the gallery we link the tier directory so users
// land on the HF file listing.
const tierLinks = mat.tiers.map((tier) => ({
  tier,
  url: tierDirUrl(meta, mat, tier),
}));

const thumb = thumbUrl(meta, mat);
const pbrEntries = Object.entries(mat.p).filter(([, v]) => v !== null && v !== undefined);

const snippet = `from mat_vis_client import MatVisClient

client = MatVisClient(tag="${meta.release_tag}")
asset = client.asset("${mat.s}", "${mat.id}")
scalars = asset.scalars
textures = asset.fetch_all_textures(tier="auto")  # post-#374
`;
---
<Base title={`${mat.n} — mat-vis`} description={`PBR material ${mat.n} from ${mat.s} (${mat.l ?? 'unlicensed'}).`}>
  <p class="back"><a href={base}>&larr; Catalog</a></p>

  <header class="detail-hero">
    <div class="thumb-wrap">
      {thumb ? (
        <img src={thumb} alt={mat.n} loading="lazy" />
      ) : (
        <div class="thumb-placeholder">no preview thumb</div>
      )}
    </div>
    <div class="hero-meta">
      <h1>{mat.n}</h1>
      <div class="badges">
        <span class="badge source">{mat.s}</span>
        {mat.c && <span class="badge">{mat.c}</span>}
        {mat.l && <span class="badge license">{mat.l}</span>}
      </div>
      <dl class="kv">
        <dt>ID</dt><dd><code>{mat.id}</code></dd>
        {mat.u && <><dt>Upstream</dt><dd><a href={mat.u} target="_blank" rel="noopener">{mat.u}</a></dd></>}
        {mat.a.length > 0 && <><dt>Authors</dt><dd>{mat.a.join(", ")}</dd></>}
        {mat.d.p && <><dt>Published</dt><dd>{mat.d.p}</dd></>}
        {mat.d.u && mat.d.u !== mat.d.p && <><dt>Updated</dt><dd>{mat.d.u}</dd></>}
        {mat.t.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd>
              {mat.t.map((tag) => <span class="tag">{tag}</span>)}
            </dd>
          </>
        )}
      </dl>
    </div>
  </header>

  <section class="block">
    <h2>PBR scalars</h2>
    {pbrEntries.length === 0 ? (
      <p class="muted">No scalar values published for this material.</p>
    ) : (
      <table class="pbr">
        <tbody>
          {pbrEntries.map(([k, v]) => (
            <tr>
              <th>{k}</th>
              <td><code>{typeof v === "object" ? JSON.stringify(v) : String(v)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <section class="block">
    <h2>Texture tiers</h2>
    {tierLinks.length === 0 ? (
      <p class="muted">No texture tiers published — scalar-only material.</p>
    ) : (
      <ul class="tiers">
        {tierLinks.map(({ tier, url }) => (
          <li><a href={url} target="_blank" rel="noopener"><code>{tier}</code></a></li>
        ))}
      </ul>
    )}
  </section>

  <section class="block">
    <h2>Use in build123d</h2>
    <pre><code>{snippet}</code></pre>
  </section>

  <section class="block muted">
    <h2>Attribution</h2>
    <p>
      {mat.l && <>License: <span class="badge license">{mat.l}</span>. </>}
      {mat.a.length > 0 && <>By {mat.a.join(", ")}. </>}
      Source: <a href={mat.u ?? `https://${mat.s}.com/`} target="_blank" rel="noopener">{mat.s}</a>.
    </p>
  </section>
</Base>

<style>
  .back { margin-top: 0; }
  .detail-hero {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2rem;
  }
  @media (max-width: 720px) {
    .detail-hero { grid-template-columns: 1fr; }
  }
  .thumb-wrap {
    aspect-ratio: 1 / 1;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-placeholder { color: var(--fg-mute); font-style: italic; }
  .hero-meta h1 { margin: 0 0 0.5rem 0; }
  .badges { display: flex; gap: 0.35rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
  }
  .kv dt { color: var(--fg-mute); font-size: 0.85rem; }
  .kv dd { margin: 0; word-break: break-word; }
  .tag {
    display: inline-block;
    margin: 0 0.25rem 0.25rem 0;
    padding: 0.05rem 0.4rem;
    background: var(--bg-3);
    border-radius: 0.25rem;
    font-size: 0.8rem;
  }
  .block { margin: 2rem 0; }
  .block h2 {
    font-size: 1.1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
  }
  table.pbr {
    border-collapse: collapse;
    width: 100%;
    max-width: 32rem;
  }
  table.pbr th, table.pbr td {
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }
  table.pbr th { color: var(--fg-mute); font-weight: 500; width: 12rem; }
  ul.tiers { list-style: none; padding: 0; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  ul.tiers li a {
    display: inline-block;
    padding: 0.3rem 0.6rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
  }
  .muted { color: var(--fg-mute); }
</style>
