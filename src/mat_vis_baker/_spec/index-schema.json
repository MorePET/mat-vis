{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MorePET/mat-vis/docs/specs/index-schema.json",
  "schema_version": 3,
  "title": "Material Index File (v3)",
  "description": "Schema for index/<source>.json files. Each file is an array of material entries from a single upstream source. v3 is the Layer-1 clean break introduced by ADR-0011 / mat-vis#152: every semantic field lives under `mat_vis`; the envelope only carries bake-pipeline state.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "source",
      "mat_vis",
      "maps"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier within the source, e.g. \"Metal064\", \"rusty_metal\". Must be unique per source file.",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "description": "Upstream source identifier.",
        "enum": ["ambientcg", "polyhaven", "gpuopen", "physicallybased"]
      },
      "mat_vis": {
        "type": "object",
        "description": "Layer-1 curated contract (see mat-vis-block-v3.json).",
        "required": [
          "name",
          "category",
          "tags",
          "description",
          "physical",
          "pbr",
          "attribution",
          "dates",
          "upstream_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable display name."
          },
          "category": {
            "type": "string",
            "description": "Normalized material category.",
            "enum": [
              "metal",
              "wood",
              "stone",
              "fabric",
              "plastic",
              "concrete",
              "ceramic",
              "glass",
              "organic",
              "other"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Freeform tags from the upstream source, lowercased.",
            "items": {"type": "string"}
          },
          "description": {
            "type": ["string", "null"],
            "description": "Long-form description, if the upstream provides one."
          },
          "physical": {
            "type": "object",
            "required": ["dimensions_m", "max_resolution_px"],
            "additionalProperties": false,
            "properties": {
              "dimensions_m": {
                "type": ["array", "null"],
                "description": "Physical dimensions [x, y] or [x, y, z] in metres.",
                "items": {"type": ["number", "null"]},
                "minItems": 2,
                "maxItems": 3
              },
              "max_resolution_px": {
                "type": ["array", "null"],
                "description": "Maximum texture resolution [w, h] in pixels.",
                "items": {"type": "integer", "minimum": 1},
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "pbr": {
            "type": "object",
            "required": [
              "color_rgb",
              "roughness",
              "metalness",
              "ior",
              "specular_f0",
              "transmission",
              "complex_ior"
            ],
            "additionalProperties": false,
            "properties": {
              "color_rgb": {
                "type": ["array", "null"],
                "description": "Base colour as [r, g, b] floats in [0, 1].",
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "roughness": {
                "type": ["number", "null"],
                "minimum": 0.0,
                "maximum": 1.0
              },
              "metalness": {
                "type": ["number", "null"],
                "minimum": 0.0,
                "maximum": 1.0
              },
              "ior": {
                "type": ["number", "null"],
                "minimum": 0.0
              },
              "specular_f0": {
                "type": ["array", "null"],
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "transmission": {
                "type": ["number", "null"],
                "minimum": 0.0,
                "maximum": 1.0
              },
              "complex_ior": {
                "type": ["array", "null"],
                "description": "Wavelength-resolved complex IOR (6 floats).",
                "items": {"type": "number"},
                "minItems": 6,
                "maxItems": 6
              }
            }
          },
          "attribution": {
            "type": "object",
            "required": ["authors", "license_spdx", "source_url"],
            "additionalProperties": false,
            "properties": {
              "authors": {
                "type": "array",
                "items": {"type": "string"}
              },
              "license_spdx": {
                "type": "string",
                "description": "SPDX license identifier.",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "description": "URL of the upstream material page."
              }
            }
          },
          "dates": {
            "type": "object",
            "required": ["published", "updated"],
            "additionalProperties": false,
            "properties": {
              "published": {
                "type": ["string", "null"],
                "description": "ISO-8601 date (YYYY-MM-DD)."
              },
              "updated": {
                "type": ["string", "null"],
                "description": "ISO-8601 date (YYYY-MM-DD)."
              }
            }
          },
          "upstream_id": {
            "type": "string",
            "description": "Native id of the material in the upstream API."
          }
        }
      },
      "available_tiers": {
        "type": "array",
        "description": "Resolution + format tiers available for this material. Texture tiers: 128/256/512/1k/2k/4k/8k (pixel size). Format-prefixed tiers: ktx2-{size} (Basis-compressed). Resolution-independent: mtlx (MaterialX document).",
        "items": {
          "type": "string",
          "pattern": "^(128|256|512|[1248]k|ktx2-(128|256|512|[1248]k)|mtlx|mtlx-original)$"
        },
        "minItems": 0,
        "uniqueItems": true
      },
      "maps": {
        "type": "array",
        "description": "Texture map channels available for this material.",
        "items": {
          "type": "string",
          "enum": [
            "color",
            "normal",
            "roughness",
            "metalness",
            "ao",
            "displacement",
            "emission"
          ]
        },
        "minItems": 0,
        "uniqueItems": true
      },
      "texture_hashes": {
        "type": "object",
        "description": "SHA-256 hashes and sizes of the full-resolution baked PNGs per channel. Used for integrity verification and upstream change detection.",
        "additionalProperties": {
          "type": "object",
          "required": ["sha256", "size"],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "propertyNames": {
          "enum": ["color", "normal", "roughness", "metalness", "ao", "displacement", "emission"]
        }
      },
      "status": {
        "type": "string",
        "description": "Bake status. Present only when bake failed.",
        "enum": ["ok", "failed"]
      }
    }
  }
}
